# RetailMind Environment Configuration Example
# Copy to backend/.env and configure your variables

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/retailmind?retryWrites=true&w=majority
MONGODB_DB_NAME=retailmind

# Server Port
PORT=5000

# ML Microservice URL
ML_SERVICE_URL=http://localhost:8000

# Client Application URL (for CORS and WebSockets)
CLIENT_URL=http://localhost:5173

# Live Simulation Engine Configuration
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=4000

# Security Secret
JWT_SECRET=retailmind_edge_ai_jwt_secret_change_in_production
